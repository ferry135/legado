<?xml version="1.0" encoding="utf-8"?>
<!-- 13-read-style#18：色板单元格竖排——48dp 圆形色块 + 12sp 预设名（名称移出圆外）；
     描边宽度由 ReadStyleDialog 按选中态切换（未选 1dp 25% ink / 选中 2dp 主色） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <io.legado.app.ui.widget.image.CircleImageView
        android:id="@+id/iv_style"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/image_cover_default"
        app:civ_border_color="@color/primaryText"
        app:civ_border_width="1dp" />

    <TextView
        android:id="@+id/tv_style_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="72dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        tools:text="预设1" />

</LinearLayout>
