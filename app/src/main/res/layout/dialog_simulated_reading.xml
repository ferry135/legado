<?xml version="1.0" encoding="utf-8"?>
<!-- 模拟追读（12-missed-2 #03）：标签上、值下的 field 卡排版 + 两列数字输入 + 日更语义提示行；控件 id 不变 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/switch_on"
            android:textColor="@color/primaryText"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sr_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.AppCompat.CompoundButton.Switch" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_edit_filled"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="7dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_from"
            android:textColor="@color/secondaryText"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/start_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:clickable="true"
            android:ems="10"
            android:hint="Select date"
            android:importantForAutofill="no"
            android:inputType="none"
            android:minHeight="24dp"
            android:textColor="@color/primaryText"
            android:textColorHint="@color/secondaryText"
            android:textCursorDrawable="@drawable/shape_text_cursor"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_filled"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="7dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_chapter"
                android:textColor="@color/secondaryText"
                android:textSize="11.5sp" />

            <EditText
                android:id="@+id/edit_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="@string/start"
                android:importantForAutofill="no"
                android:inputType="number"
                android:lines="1"
                android:maxLength="5"
                android:minHeight="24dp"
                android:textColor="@color/primaryText"
                android:textColorHint="@color/secondaryText"
                android:textCursorDrawable="@drawable/shape_text_cursor"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_filled"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="7dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_chapters"
                android:textColor="@color/secondaryText"
                android:textSize="11.5sp" />

            <EditText
                android:id="@+id/edit_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="3"
                android:importantForAutofill="no"
                android:inputType="number"
                android:lines="1"
                android:maxLength="5"
                android:minHeight="24dp"
                android:textAlignment="center"
                android:textColor="@color/primaryText"
                android:textColorHint="@color/secondaryText"
                android:textCursorDrawable="@drawable/shape_text_cursor"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:lineSpacingMultiplier="1.7"
        android:text="@string/simulated_reading_hint"
        android:textColor="@color/secondaryText"
        android:textSize="11.5sp" />

</LinearLayout>
