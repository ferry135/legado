<?xml version="1.0" encoding="utf-8"?>
<!-- 10-reader-prefs#07 / 14-reader-brightness#04：.frow 行形态 —— 14.5sp on_surface 字体名、
     行高 52dp、选中项主色对勾+主色字（对勾与字色不在此固化 primary：FontAdapter.convert
     以 context.primaryColor 运行时着色，随 ThemeStore 换肤，MASTER §4） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingTop="10dp"
    android:paddingRight="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_font"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14.5sp"
        android:textColor="@color/primaryText" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_checked"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible" />

</LinearLayout>