<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:attachToActivity="false"
        app:themeMode="blend"
        app:title="@string/bookshelf" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_tab_capsule">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                app:tabIndicator="@drawable/bg_tab_indicator_pill_inset"
                app:tabIndicatorColor="@color/accent"
                app:tabIndicatorGravity="center"
                app:tabIndicatorHeight="48dp"
                app:tabMinWidth="88dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="22dp"
                app:tabPaddingStart="22dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/md_white_1000"
                app:tabTextAppearance="@style/TextAppearance.Legado.Tab"
                app:tabTextColor="@color/on_surface_variant" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:text="@string/bookshelf_px_0"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_arrow_drop_down"
            app:drawableTint="@color/on_surface_variant" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_bookshelf"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
