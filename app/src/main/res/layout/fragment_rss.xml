<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- .appbar.main-title：28sp 粗体大标题（PageTitle），blend 同色顶栏、无分割线 -->
    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:attachToActivity="false"
        app:contentLayout="@layout/view_search"
        app:layout_constraintTop_toTopOf="parent"
        app:themeMode="blend"
        app:title="@string/rss"
        app:titleTextAppearance="@style/TextAppearance.Legado.PageTitle" />

    <!-- .grid：padding 10px 14px 24px，行距 22px 由 item 底距提供 -->
    <io.legado.app.ui.widget.recycler.RecyclerViewAtPager2
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        tools:listitem="@layout/item_rss" />

    <!-- 空态（v3）：EmptyTipView 单一实现（圆底图标变体），RssFragment 按订阅源为空控制显隐 -->
    <io.legado.app.ui.widget.EmptyTipView
        android:id="@+id/empty_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone"
        app:empty_icon="@drawable/ic_bottom_rss_feed_e"
        app:empty_icon_circled="true"
        app:empty_tip="@string/rss_source_empty_tip"
        app:empty_title="@string/rss_source_empty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>