<?xml version="1.0" encoding="utf-8"?>
<!-- RSS 阅读记录行（generic-list-dialogs 稿 §04/§06 #13/#14 升级）：去行内横向滚动——原双
     HorizontalScrollView 各包 singleLine TextView（行内横滚与列表纵滚手势冲突、TalkBack 顺序
     混乱、无文字令牌），改纵向两行 TextView；title 15sp/500 on_surface、record 12.5sp
     on_surface_variant + autoLink=web（链接主色运行时 accentColor 注入，XML 仅 link_color
     兜底），均 ellipsize=end（URL 不再行内滚动，全链可长按复制/点击，不新增行为）；
     id text_title/text_record 不变（ReadRecordDialog.kt 绑定零改动）；padding 10/16 两行
     ≥56dp 触控；行不可点击（现状），背景 selectableItemBackground 仅按压一致性预留 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp"
    tools:ignore="RtlHardcoded">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="@string/title"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/text_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:autoLink="web"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/read_record"
        android:textColor="@color/on_surface_variant"
        android:textColorLink="@color/link_color"
        android:textSize="12.5sp" />

</LinearLayout>
