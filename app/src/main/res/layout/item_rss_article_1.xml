<?xml version="1.0" encoding="utf-8"?>
<!-- S2 文章卡·大图变体（articleStyle 1，rss-articles.html #02）：通栏大图 200dp（radius 12=corner_radius_md、
     marginH 20/marginTop 14）→ 标题 16sp bold 1.42 行距两行 → 斜体时间 12sp on_surface_variant；
     原 paddingTop 贴边图与 8dp 分隔色带 → 内缩圆角大图 + 1px 分割线（bg_divider_line→outline_variant，
     与基准行 VerticalDivider 同令牌）；无图条目 image_view gone 退化为纯文字块（适配器 onLoadFailed 同） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <io.legado.app.ui.widget.image.FilletImageView
        android:id="@+id/image_view"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@string/loading"
        android:scaleType="centerCrop"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="12dp" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.42"
        android:maxLines="2"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/app_name"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_view" />

    <TextView
        android:id="@+id/tv_pub_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp"
        android:text="@string/app_name"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="italic"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        tools:text="2026-10-26 18:30" />

    <!-- 原 8dp 分隔色带 → 1px 分割线（列表态另有 VerticalDivider/ic_divider 同色 1px 相邻叠加，视觉为一条） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_divider_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pub_date" />

</androidx.constraintlayout.widget.ConstraintLayout>
