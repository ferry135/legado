<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读记录行（read-record-page.html §05 第 5/6 条重排）：书名 15sp medium on_surface 单行省略、
     两行 12sp on_surface_variant 元信息（标签字符串 reading_time_tag / last_read_time_tag 不动）、
     行内边距 13/16、最小行高 64dp；行分割线由 kt addItemDecoration（VerticalDivider 左缩进 16dp）
     承担（§05 第 7 条，行间线不画在 item 内）；「清除」文字钮 → 48×48dp 删除图标钮
     （复用 ic_outline_delete，tint on_surface_variant）；绑定逻辑零改动（ReadRecordActivity.kt:172-179） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:paddingLeft="16dp"
    android:paddingTop="13dp"
    android:paddingRight="4dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@color/on_surface"
        android:textSize="15sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_remove"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlHardcoded"
        tools:text="诡秘之主" />

    <TextView
        android:id="@+id/tv_reading_time_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:text="@string/reading_time_tag"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_book_name" />

    <TextView
        android:id="@+id/tv_reading_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/tv_reading_time_tag"
        app:layout_constraintRight_toLeftOf="@+id/tv_remove"
        app:layout_constraintTop_toBottomOf="@id/tv_book_name"
        tools:ignore="RtlHardcoded"
        tools:text="12天7小时36分钟" />

    <TextView
        android:id="@+id/tv_last_read_time_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:text="@string/last_read_time_tag"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reading_time_tag" />

    <TextView
        android:id="@+id/tv_last_read_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/tv_last_read_time_tag"
        app:layout_constraintRight_toLeftOf="@+id/tv_remove"
        app:layout_constraintTop_toBottomOf="@id/tv_reading_time_tag"
        tools:ignore="RtlHardcoded"
        tools:text="2026-11-03" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tv_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clear"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_outline_delete"
        app:tint="@color/on_surface_variant"
        tools:ignore="RtlHardcoded" />

</androidx.constraintlayout.widget.ConstraintLayout>
