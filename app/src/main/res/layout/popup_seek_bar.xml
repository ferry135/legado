<?xml version="1.0" encoding="utf-8"?>
<!-- 听书定时滑条弹窗（audio-timer-popup §01/§03）：外包 FrameLayout 给 12dp 水平安全边距
     （PopupWindow 本体仍 MATCH_PARENT，TimerSliderPopup.kt 宽高参数不动）；
     卡体 16dp 圆角 + 1dp outline_variant 描边（弃 shape_card_view 3dp 矩形引用）；
     tv_seek_value 数值升格 22sp bold on_surface 居中（根 gravity=center_horizontal 保留，:8 现状）；
     新增「定时」标签（须 layout_gravity=start，否则被根 gravity 居中）与 0/180 端点刻度
     （seekBar.max=180，TimerSliderPopup.kt:27）；快捷预设芯片行（新增·可整行移除）：
     点击直调 AudioPlay.setTimer，选中态运行时 accentColor 着色（TimerSliderPopup.kt）。
     行为不变：max=180 / 拖动即设值 / 显示回填 timeMinute -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_book_audio_timer_slider_popup_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- 「定时」标签：复用 @string/set_timer（iv_timer contentDescription 同源，零新增字符串） -->
        <TextView
            android:id="@+id/tv_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/set_timer"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_seek_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 0 / 180 端点刻度 + 滑条（ThemeSeekBar 运行时 accentColor 换肤安全，不换）；
             minHeight 48dp 补触控目标（默认拇指热区约 24dp），轨道底统一 outline_variant 令牌 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="0"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <io.legado.app.lib.theme.view.ThemeSeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:progressBackgroundTint="@color/outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="180"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- 快捷预设芯片行（新增·可移除）：10/30/60/90/关闭(=0 取消定时)；选中态由 TimerSliderPopup 运行时着色。
             HorizontalScrollView 兜底大字体（fontScale 1.8/2.0）横向溢出（同 dict .ptabs.scroll 先例），
             内容不超宽时 fillViewport 拉满、视觉与普通行一致 -->
        <HorizontalScrollView
            android:id="@+id/sv_timer_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/vw_timer_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_timer_10"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_book_audio_timer_slider_popup_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="10"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/chip_timer_30"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_book_audio_timer_slider_popup_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="30"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/chip_timer_60"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_book_audio_timer_slider_popup_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="60"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/chip_timer_90"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_book_audio_timer_slider_popup_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="90"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/chip_timer_off"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_book_audio_timer_slider_popup_chip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/close"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</FrameLayout>
