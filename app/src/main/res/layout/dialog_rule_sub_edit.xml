<?xml version="1.0" encoding="utf-8"?>
<!-- 规则订阅编辑弹窗（rule-sub-edit 稿）：alert() customView，新建与编辑共用。
     类型行 Holo Spinner 裸行（AccentTextView + styles.xml:54 Spinner）→ field 分发卡
     （label/值左列 + 尾部 20dp 下拉箭头 + 圆角 menu 弹层），名称/Url TextInputLayout →
     filled field 卡（bg_edit_filled，同 dialog_bookmark.xml 栅格）；hint 删除防 label+hint
     双显，空态值行留白由 label 承载字段名。
     控件 id（sp_type/et_name/et_url）与保存行为全部保留；三张 field 卡聚焦描边与分发卡
     整卡触控桥接由 RuleSubActivity.editSubscription 运行时装配（稿 §04·4/6，换肤安全） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <!-- 类型分发卡（§04·3/4）：bg_edit_filled 静态兜底 + addStatesFromChildren 供聚焦描边透传；
         AppCompat Spinner 仅响应自身 bounds 点击，整卡触控须桥接（editSubscription 内
         vwFieldType 点击转 spType.performClick()）；android:theme="@style/Spinner"（Holo）不再引用 -->
    <LinearLayout
        android:id="@+id/vw_field_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_edit_filled"
        android:clickable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/sp_type"
                android:text="@string/book_type"
                android:textColor="@color/secondaryText"
                android:textSize="11.5sp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:dropDownVerticalOffset="4dp"
                android:entries="@array/rule_type"
                android:minHeight="24dp"
                android:popupBackground="@drawable/bg_rss_subscription_rule_sub_activity_menu_rounded"
                tools:ignore="SpeakableTextPresentCheck" />

        </LinearLayout>

        <!-- 尾部下拉箭头（稿 .chev 20px，secondary）：装饰性，触控目标由整卡（≥52dp）承担 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/secondaryText" />

    </LinearLayout>

    <!-- 名称 field 卡（§04·5）：TextInputLayout 外壳移除，原 hint「名称」迁移为 label，
         et_name 保留（background @null、textSize 14sp）；聚焦描边运行时注入 -->
    <LinearLayout
        android:id="@+id/vw_field_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_edit_filled"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/et_name"
            android:text="@string/name"
            android:textColor="@color/secondaryText"
            android:textSize="11.5sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:minHeight="24dp"
            android:textColor="@color/primaryText"
            android:textSize="14sp"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- Url field 卡（§04·5）：末卡 marginBottom 0（根 paddingBottom 承担底距），
         原硬编码 hint「Url」迁移为 label；聚焦描边运行时注入 -->
    <LinearLayout
        android:id="@+id/vw_field_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_edit_filled"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/et_url"
            android:text="Url"
            android:textColor="@color/secondaryText"
            android:textSize="11.5sp"
            tools:ignore="HardcodedText" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:minHeight="24dp"
            android:textColor="@color/primaryText"
            android:textSize="14sp"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    </LinearLayout>

</LinearLayout>
