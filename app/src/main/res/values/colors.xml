    <color name="scrim">#52000000</color>

    //**设计稿 v2 补充令牌（design-system/html/screens 01-08，明暗成对）**//
    <!-- primary-soft 底上的文字：亮色加深至 #B34A15 保 AA 对比（02 书籍详情 chip-soft），暗色用主色 -->
    <color name="on_primary_soft">#B34A15</color>
    <!-- 搜索胶囊聚焦描边 / 虚线提示框描边（04 主色 35%/45%） -->
    <color name="primary_soft_line">#59FF6B2C</color>
    <!-- 搜索结果灰底徽标（"广告"等，04） -->
    <color name="badge_background">#60656D</color>
    <!-- 链接色（书源调试日志 05） -->
    <color name="link_color">#2F6DB3</color>
    <!-- 阅读菜单亮度侧面板：surface2 93% 半透明（03） -->
    <color name="read_panel">#EDEEECE9</color>
    <!-- 对话框遮罩 ~50%（05/07/08，较 scrim 更深） -->
    <color name="scrim_dialog">#80000000</color>
    <!-- 书籍详情 hero 渐变（02，自上而下） -->
    <color name="hero_gradient_start">#F7E8D9</color>
    <color name="hero_gradient_end">#F0D2B9</color>
    <!-- 警示色（02/05 换源「踩」iv_bad 激活态，稿面 #C2551F；明暗同值） -->
    <color name="warning">#C2551F</color>
    <!-- 扫码取景辅助提示（08，相机预览上白 60%，设计 08:103 rgba(255,255,255,.6)，明暗同值） -->
    <color name="scan_hint_text">#99FFFFFF</color>

    //**设计稿 v3 补充令牌（design-system/html/screens 09-12）**//
    <!-- 听书播放器恒定暗色播放面（11-audio-light S5：明暗主题共用同一播放器视觉，取夜间 surface 层级值，有意不做 values-night 覆盖） -->
    <color name="player_surface">#141312</color>
    <!-- 备用层级：11-audio-light:503 明示「本轮仅声明」，播放面后续迭代取用；勿删 -->
    <color name="player_surface_container">#1D1B19</color>
    <color name="player_on_surface">#F3F0EB</color>
    <color name="player_on_surface_variant">#B4B0AA</color>
    <!-- 阅读页点击区域九宫格面板底（12-missed-2 #11/#29-B：96% 实色替换半透明卡白字，格面文字 on_surface，明暗成对） -->
    <color name="click_action_panel">#F0ECE9</color>
    <!-- 代码查看/编辑高亮（12-missed-2 #27：关键字橙/JSON 键蓝/注释灰，明暗两套均 ≥4.5:1） -->
    <color name="code_keyword">#C2410C</color>
    <color name="code_key">#1F6FB2</color>
    <color name="code_comment">#60656D</color>

    //**程序化写主题用固定色（无日夜变体，applyTheme 按分支直接取值，避免随启动时 configuration 漂移）**//
    <color name="day_surface">#FAF9F7</color>
    <color name="day_surface_container">#FFFFFF</color>
    <color name="day_surface_container_high">#F1EFE9</color>
    <color name="night_surface">#141312</color>
    <color name="night_surface_container">#1D1B19</color>
    <!-- on_surface_variant 角色（次要文字）的运行时对：按 bottomBackground 明暗分支取值，
         不走 values-night 限定符（EInk 白底可配夜间 uiMode，资源解析会错档） -->
    <color name="day_on_surface_variant">#60656D</color>
    <color name="night_on_surface_variant">#B4B0AA</color>
    <color name="day_bottom_nav">#FFFEFC</color>
