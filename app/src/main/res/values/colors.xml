    <color name="surface_container">#FFFFFF</color>
    <color name="surface_container_high">#EEECE9</color>
    <color name="surface_hero">#FFF1E8</color>
    <!-- primary-soft（设计稿 primary-soft，明 #FFF0E6）：底部导航指示器/RSS 勾选行/chip 柔光底共用中性令牌 -->
    <color name="primary_soft">#FFF0E6</color>
    <!-- 底部导航指示器（语义别名，指向 primary_soft） -->
    <color name="bnv_item_indicator">@color/primary_soft</color>
    <color name="on_surface">#20242B</color>
