<?xml version="1.0" encoding="utf-8"?>
<!-- 图片查看弹窗右上关闭钮底（widget-viewer-dialogs §05 ⑥）：48dp 圆形 pill_field，
     明暗成对令牌（values/colors.xml:92 #0F000000 / values-night/colors.xml:60 #14FFFFFF），
