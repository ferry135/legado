<?xml version="1.0" encoding="utf-8"?>
<!-- 听书定时滑条弹窗卡体（audio-timer-popup §03：3dp shape_card_view → 16dp 圆角 + 1dp outline_variant 描边）；
     PopupWindow 无 elevation，深色卡靠描边与暗底分层（MASTER §3 弹层级）；
     shape_card_view 多屏共用不改，本页弃其引用即可 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <corners android:radius="@dimen/corner_radius_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/outline_variant" />
</shape>
