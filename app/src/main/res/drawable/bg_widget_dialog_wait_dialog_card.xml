<?xml version="1.0" encoding="utf-8"?>
<!-- 加载中转圈小窗底（widget-viewer-dialogs §05③）：WaitDialog 是普通 android.app.Dialog，
     不走 BaseDialogFragment（拿不到运行时圆角容器），须自带圆角底——
     solid surface（#FAF9F7/#141312）+ 16dp 圆角（corner_radius_lg 令牌）+ 1dp outline_variant 描边；
     中性令牌明暗成对，不固化 primary/accent（MASTER §2/§4）。
     window 透明由 WaitDialog.kt init 注入，圆角缺口方能透出遮罩。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/corner_radius_lg" />
    <stroke android:width="1dp" android:color="@color/outline_variant" />
</shape>
